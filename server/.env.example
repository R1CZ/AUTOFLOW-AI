# AutoFlow AI Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://autoflow_user:password@localhost:5432/autoflow_ai?schema=public"

# Redis Configuration (for sessions and caching)
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-this"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Email Configuration (SendGrid, AWS SES, etc.)
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="your-sendgrid-api-key"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
EMAIL_FROM="noreply@autoflow.ai"
EMAIL_FROM_NAME="AutoFlow AI"

# Stripe Configuration (Payments)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_PRICE_STARTER="price_starter_monthly"
STRIPE_PRICE_PRO="price_pro_monthly"
STRIPE_PRICE_ENTERPRISE="price_enterprise_monthly"

# AI Provider Configuration (OpenAI, Anthropic, etc.)
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
AI_PROVIDER="openai"
AI_MODEL="gpt-4"

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="autoflow-ai-files"

# Logging
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret"
