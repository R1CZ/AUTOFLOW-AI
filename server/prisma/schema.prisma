// Prisma Schema for AutoFlow AI
// This defines the complete database structure

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(USER)
  status        UserStatus @default(ACTIVE)
  avatar        String?
  lastLogin     DateTime?
  emailVerified Boolean   @default(false)
  
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  sessions      Session[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[] @relation("AuditActor")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([email])
  @@index([companyId])
}

model Session {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([userId])
}

// ============================================================================
// COMPANY & MULTI-TENANCY
// ============================================================================

model Company {
  id                 String        @id @default(uuid())
  name               String
  industry           String?
  timezone           String        @default("UTC")
  country            String
  status             CompanyStatus @default(TRIAL)
  adminId            String        @unique
  
  admin              User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  users              User[]
  workflows          Workflow[]
  executions         Execution[]
  integrations       Integration[]
  webhooks           Webhook[]
  notifications      Notification[]
  subscription       Subscription?
  invoices           Invoice[]
  auditLogs          AuditLog[]
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  @@index([status])
  @@index([industry])
}

// ============================================================================
// PLANS & SUBSCRIPTIONS
// ============================================================================

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  monthlyPrice    Int
  annualPrice     Int
  maxUsers        Int
  maxWorkflows    Int
  maxExecutions   Int
  maxIntegrations Int
  maxWebhooks     Int
  aiCredits       Int
  features        String[]
  isActive        Boolean  @default(true)
  isTrial         Boolean  @default(false)
  trialDays       Int      @default(0)
  
  subscriptions   Subscription[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id                  String             @id @default(uuid())
  companyId           String             @unique
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(TRIAL)
  billingCycle        BillingCycle       @default(MONTHLY)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean            @default(false)
  stripeSubscriptionId String?           @unique
  
  invoices            Invoice[]
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  @@index([status])
  @@index([companyId])
}

model Invoice {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  amount          Int
  currency        String        @default("USD")
  status          InvoiceStatus @default(PENDING)
  stripeInvoiceId String?       @unique
  paidAt          DateTime?
  
  items           InvoiceItem[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([companyId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Int
  quantity    Int     @default(1)
  
  @@index([invoiceId])
}

// ============================================================================
// WORKFLOWS & EXECUTIONS
// ============================================================================

model Workflow {
  id              String         @id @default(uuid())
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  triggerType     String?
  version         Int            @default(1)
  
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById     String
  
  nodes           WorkflowNode[]
  connections     WorkflowConnection[]
  executions      Execution[]
  
  executionCount  Int            @default(0)
  successCount    Int            @default(0)
  failCount       Int            @default(0)
  lastExecuted    DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([companyId])
  @@index([status])
}

model WorkflowNode {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type        String
  label       String
  config      Json     @default("{}")
  positionX   Float
  positionY   Float
  
  @@index([workflowId])
}

model WorkflowConnection {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceId    String
  targetId    String
  label       String?
  
  @@index([workflowId])
}

model Execution {
  id            String           @id @default(uuid())
  workflowId    String
  workflow      Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status        ExecutionStatus  @default(PENDING)
  triggerType   String
  triggeredBy   String
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  duration      Int?
  nodesExecuted Int              @default(0)
  totalNodes    Int
  error         String?
  
  logs          ExecutionLog[]
  
  @@index([workflowId])
  @@index([companyId])
  @@index([status])
  @@index([startedAt])
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeLabel   String
  status      String
  timestamp   DateTime
  duration    Int
  input       Json?
  output      Json?
  error       String?
  
  @@index([executionId])
}

// ============================================================================
// INTEGRATIONS & WEBHOOKS
// ============================================================================

model Integration {
  id          String             @id @default(uuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider    String
  name        String
  status      IntegrationStatus  @default(PENDING)
  icon        String?
  category    String?
  config      Json               @default("{}")
  credentials Json?              // Encrypted
  
  connectedAt DateTime?
  lastSync    DateTime?
  
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  @@index([companyId])
  @@index([provider])
  @@index([status])
}

model Webhook {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  url         String
  secret      String
  status      WebhookStatus @default(ACTIVE)
  events      String[]
  
  successCount Int          @default(0)
  failCount    Int          @default(0)
  lastTriggered DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([companyId])
  @@index([status])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  actionUrl   String?
  read        Boolean          @default(false)
  
  createdAt   DateTime         @default(now())
  
  @@index([userId])
  @@index([companyId])
  @@index([read])
  @@index([createdAt])
}

// ============================================================================
// AUDIT LOGGING
// ============================================================================

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  actorName   String
  action      String
  resource    String
  resourceId  String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  details     Json?
  ipAddress   String?
  
  createdAt   DateTime @default(now())
  
  @@index([actorId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM SETTINGS
// ============================================================================

model PlatformSetting {
  id        String @id @default(uuid())
  key       String @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIAL
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISABLED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  RETRYING
  CANCELLED
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
  PENDING
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}
